+            H = float(K["resolution"][1])
+            fx_erp = W / (2.0 * math.pi)
+            fy_erp = H / math.pi
+            cx_erp = W / 2.0
+            cy_erp = H / 2.0
+            camera_model_parameters = _3dgut_plugin.fromOpenCVPinholeCameraModelParameters(
