"""
Creates COLMAP sparse model for V2 equirectangular dataset.
Reuses camera poses from fisheye model — same physical positions,
different camera model (EQUIRECTANGULAR instead of OPENCV_FISHEYE).

COLMAP camera model for equirectangular:
  model_id = 7 (EQUIRECTANGULAR in newer COLMAP)
  But 3DGUT does not support EQUIRECTANGULAR natively.
  
Instead we use a workaround: store as PINHOLE with very wide FOV,
and let 3DGUT handle it via its equirectangular dataset loader.
Actually the cleanest approach: check what 3DGUT supports for ERP.
"""
import struct
from pathlib import Path

# Read fisheye images.bin to get pose for each fisheye frame
def read_images_bin(path):
    images = {}
    with open(path, 'rb') as f:
        n = struct.unpack('<Q', f.read(8))[0]
        for _ in range(n):
            img_id = struct.unpack('<I', f.read(4))[0]
            qvec   = struct.unpack('<4d', f.read(32))
            tvec   = struct.unpack('<3d', f.read(24))
            cam_id = struct.unpack('<I', f.read(4))[0]
            name   = b''
            while True:
                c = f.read(1)
                if c == b'\x00': break
                name += c
            name = name.decode('utf-8')
            n2d  = struct.unpack('<Q', f.read(8))[0]
            pts  = struct.unpack(f'<{3*n2d}d', f.read(24*n2d)) if n2d else ()
            images[img_id] = dict(qvec=qvec, tvec=tvec, cam_id=cam_id,
                                  name=name, n2d=n2d, pts=pts)
    return images

fisheye_images = read_images_bin('meetingroom/model/images.bin')

# Build lookup: frame_number -> pose from cam1 fisheye images
# fisheye filename: IMG_20241120_000613_00_729_fisheye1.png -> frame number = 729
frame_to_pose = {}
for img_id, im in fisheye_images.items():
    if 'cam1' in im['name'] and 'fisheye1' in im['name']:
        # Extract frame number from filename
        parts = Path(im['name']).stem.split('_')
        frame_num = parts[4]  # e.g. '729'
        frame_to_pose[frame_num] = im

print(f"Found {len(frame_to_pose)} cam1 poses in fisheye model")

# Check which of our 16 selected frames have poses
selected = sorted(Path('meetingroom_v2_small/images').glob('*.png'))
print(f"\nChecking {len(selected)} selected equirect frames:")
matched = []
for img_path in selected:
    # frame_729.png -> '729'
    frame_num = img_path.stem.split('_')[1]
    if frame_num in frame_to_pose:
        print(f"  {img_path.name} -> pose found (cam_id={frame_to_pose[frame_num]['cam_id']})")
        matched.append((img_path, frame_num, frame_to_pose[frame_num]))
    else:
        print(f"  {img_path.name} -> NO POSE FOUND")

print(f"\nMatched: {len(matched)}/{len(selected)} frames")
EOF

